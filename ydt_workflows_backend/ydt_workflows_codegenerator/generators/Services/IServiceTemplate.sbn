        {{- end }}

        {{- for property in properties }}
        {{- if property.key =="PRI" }}
        /// <summary>
        /// 5、{{comment}}删除
        /// </summary>
        /// <returns></returns>
        public Task<bool> {{name}}DeleteAsync(List<{{property.type}}> {{property.name}}s);
